---
// Base Layout — shared shell for all main-site pages
import { site } from '../data/queries';
const s = site();
const base = import.meta.env.BASE_URL; // '/annamatejska.pl/' on GH Pages, '/' local

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const ogImage = image || `${base}images/hero.jpg`;
const fullSite = 'https://michalgazda.github.io';
// Astro.url.pathname already includes the base prefix — never prepend it again
const canonicalUrl = `${fullSite}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${fullSite}${ogImage}`} />
  <meta property="og:locale" content="pl_PL" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${fullSite}${ogImage}`} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23fafaf8'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%230d0d0d' stroke-width='2'/%3E%3C/svg%3E" />
  <link rel="stylesheet" href={`${base}styles/fonts.css`} />
  <link rel="stylesheet" href={`${base}styles/global.css`} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": fullSite + base + "#anna",
    "name": s.name,
    "description": "Fotograf rodzinny, kobiecy, ciążowy i wizerunkowy w Krakowie.",
    "url": fullSite + base,
    "telephone": s.phoneIntl,
    "email": s.email,
    "image": fullSite + base + "images/hero.jpg",
    "jobTitle": "Fotograf",
    "address": { "@type": "PostalAddress", "addressLocality": "Kraków", "addressCountry": "PL" },
    "areaServed": s.area,
    "sameAs": [s.instagram.url, s.facebook.url]
  })} />
</head>
<body>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <header>
    <nav class="nav">
      <a class="brand" href={base}>Anna Matejska<em>-Gazda</em></a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
      <div class="nav-links" id="site-nav">
        <a href={`${base}#o-mnie`}>O mnie</a>
        <a href={`${base}#sesje`}>Sesje</a>
        <a href={`${base}galerie`}>Galerie</a>
        <a href={`${base}kadrowania/`}>Kadrowania</a>
        <a href={`${base}#opinie`}>Opinie</a>
        <a href={`${base}kontakt`} class="btn">Umów sesję</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="container">
      <span>© 2026 Anna Matejska-Gazda Fotografia · Kraków</span>
      <span>
        <a href="https://www.instagram.com/annamatejska.fotografia/">Instagram</a>
        · <a href="https://www.facebook.com/annamatejska.fotografia">Facebook</a>
        · <a href={`${base}kadrowania/`}>kadrowania</a>
      </span>
    </div>
  </footer>

  <script is:inline src={`${base}scripts/main.js`}></script>
</body>
</html>