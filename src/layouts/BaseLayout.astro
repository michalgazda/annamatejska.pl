---
// Base Layout — shared shell for all main-site pages
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { site, services } from '../data/queries';
const s = site();
const navServices = services();
const base = import.meta.env.BASE_URL; // '/annamatejska.pl/' on GH Pages, '/' local

// Cache-busting: content hash of the static assets, so a rebuilt site is picked up
// immediately instead of serving a cached copy of the previous CSS/JS.
const assetV = (p) => createHash('md5').update(readFileSync(p)).digest('hex').slice(0, 8);
const cssV = assetV('public/styles/global.css');
const jsV = assetV('public/scripts/main.js');

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const ogImage = image || `${base}images/hero.jpg`;
const fullSite = 'https://michalgazda.github.io';
// Astro.url.pathname already includes the base prefix — never prepend it again
const canonicalUrl = `${fullSite}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${fullSite}${ogImage}`} />
  <meta property="og:locale" content="pl_PL" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${fullSite}${ogImage}`} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23fafaf8'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%230d0d0d' stroke-width='2'/%3E%3C/svg%3E" />
  <link rel="stylesheet" href={`${base}styles/fonts.css`} />
  <link rel="stylesheet" href={`${base}styles/global.css?v=${cssV}`} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": fullSite + base + "#anna",
    "name": s.name,
    "description": "Fotograf rodzinny, kobiecy, ciążowy i wizerunkowy w Krakowie.",
    "url": fullSite + base,
    "telephone": s.phoneIntl,
    "email": s.email,
    "image": fullSite + base + "images/hero.jpg",
    "jobTitle": "Fotograf",
    "address": { "@type": "PostalAddress", "addressLocality": "Kraków", "addressCountry": "PL" },
    "areaServed": s.area,
    "sameAs": [s.instagram.url, s.facebook.url]
  })} />
</head>
<body>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <header>
    <nav class="nav">
      <a class="brand" href={base} aria-label="Anna Matejska-Gazda Fotografia — strona główna">Anna Matejska-Gazda</a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
      <div class="nav-links" id="site-nav">
        <a href={`${base}o-mnie`}>O mnie</a>
        <a href={`${base}galerie`}>Portfolio</a>
        <span class="has-sub">
          <a href={`${base}#sesje`}>Sesje<span class="caret">▾</span></a>
          <span class="sub">
            {navServices.map(x => <a href={`${base}sesje/${x.slug}`}>{x.category || x.title}</a>)}
          </span>
        </span>
        <a href={`${base}reportaze`}>Reportaże</a>
        <span class="has-sub">
          <a href={`${base}oferta`}>Oferta<span class="caret">▾</span></a>
          <span class="sub">
            <a href={`${base}oferta`}>Cennik i pakiety</a>
            <a href={`${base}albumy`}>Albumy</a>
            <a href={`${base}vouchery`}>Vouchery</a>
            <a href={`${base}studio`}>Studio</a>
            <a href={`${base}sesja-fotograficzna-krok-po-kroku`}>Krok po kroku</a>
            <a href={`${base}oferta-ngo`}>Oferta NGO</a>
            <a href={`${base}regulamin`}>Regulamin</a>
          </span>
        </span>
        <a href={`${base}kontakt`}>Kontakt</a>
        <span class="nav-social">
          <a href={s.facebook.url} target="_blank" rel="noopener" aria-label="Facebook — Anna Matejska-Gazda Fotografia">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.6-1.5h1.3V5.1c-.2 0-1-.1-1.9-.1-1.9 0-3.3 1.2-3.3 3.4V11H8.7v3h2.5v7h2.3z"/></svg>
          </a>
          <a href={s.instagram.url} target="_blank" rel="noopener" aria-label="Instagram — annamatejska.fotografia">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
        </span>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="container">
      <span>© 2026 Anna Matejska-Gazda Fotografia · Kraków</span>
      <a class="foot-logo" href={`${base}`} aria-label="Anna Matejska-Gazda Fotografia — strona główna">
        <img src={`${base}images/logo-anna-matejska-gazda.png`} alt="Anna Matejska-Gazda Fotografia" width="240" height="240" loading="lazy" decoding="async" />
      </a>
      <span>
        <a href="https://www.instagram.com/annamatejska.fotografia/">Instagram</a>
        · <a href="https://www.facebook.com/annamatejska.fotografia">Facebook</a>
        · <a href={`${base}kadrowania/`}>kadrowania</a>
      </span>
    </div>
  </footer>

  <script is:inline src={`${base}scripts/main.js?v=${jsV}`}></script>
</body>
</html>