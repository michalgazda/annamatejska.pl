---
import KadrowaniaLayout from '../../layouts/KadrowaniaLayout.astro';
const base = import.meta.env.BASE_URL;
const ki = (p) => `${base}kadrowania/images/${p}`;
const pi = (cat, n) => `${base}kadrowania/images/portfolio/${cat}/${String(n).padStart(2,'0')}.jpg`;

const categories = ['Wydarzenia', 'Architektura', 'Podróże'];
const catSlug = (name) => name === 'Podróże' ? 'podroze' : name.toLowerCase();
const portfolioItems = [
  { cat: 'wydarzenia', title: 'Sąsiedzki festyn', wide: true },
  { cat: 'architektura', title: 'Kamienice' },
  { cat: 'podroze', title: 'Góry' },
  { cat: 'wydarzenia', title: 'Wernisaż', wide: true },
  { cat: 'architektura', title: 'Kapliczki' },
  { cat: 'podroze', title: 'Nad morzem' },
  { cat: 'wydarzenia', title: 'Warsztaty' },
  { cat: 'architektura', title: 'Przestrzenie publiczne' },
  { cat: 'podroze', title: 'W drodze', wide: true },
  { cat: 'wydarzenia', title: 'Koncerty' },
  { cat: 'architektura', title: 'Podwórka' },
  { cat: 'podroze', title: 'Miasteczka' },
];
function imgNum(cat) {
  // map each category to sequential images
  const map = { wydarzenia: [1,2,3,4], architektura: [1,2,3,4], podroze: [1,2,3,4] };
  const c = portfolioItems.filter(i => i.cat === cat);
  const idx = c.findIndex(i => i.cat === cat && !i._used);
  // distribute
  return 0; // placeholder — we'll just cycle 1-4
}
// Simple: assign images 1-4 per category in order
const catCounts = {};
portfolioItems.forEach((item, idx) => {
  if (!catCounts[item.cat]) catCounts[item.cat] = 0;
  catCounts[item.cat]++;
  item._img = catCounts[item.cat];
});
---

<KadrowaniaLayout title="kadrowania — Anna Matejska-Gazda | fotografia wydarzeń, architektury i podróży" description="Fotografia dla małych lokalnych marek, organizacji społecznych i placówek kultury.">

  <section class="hero">
    <img class="hero__bg" src={ki('hero.jpg')} alt="Kadrowania - fotografia" fetchpriority="high" />
    <div class="wrap hero__overlay">
      <div class="eyebrow">Anna Matejska-Gazda · Kraków</div>
      <h1>Kadrowania<span>fotografia dla ludzi i miejsc</span></h1>
    </div>
  </section>

  <section class="section-label">
    <div class="wrap">
      <h2>Wybrane kadry</h2>
      <p>Wydarzenia · Architektura · Podróże</p>
    </div>
    <div class="filter" role="group" aria-label="Filtr">
      <button class="filter__btn is-active" data-filter="*" aria-pressed="true">Wszystko</button>
      <button class="filter__btn" data-filter="wydarzenia" aria-pressed="false">Wydarzenia</button>
      <button class="filter__btn" data-filter="architektura" aria-pressed="false">Architektura</button>
      <button class="filter__btn" data-filter="podroze" aria-pressed="false">Podróże</button>
    </div>
  </section>

  <div class="portfolio-grid">
    {portfolioItems.map((item) => {
      const wideClass = item.wide ? ' portfolio-grid__item--wide' : '';
      const c = item.cat;
      const n = item._img > 4 ? 4 : item._img;
      return (
        <figure class={`portfolio-grid__item${wideClass}`} data-cat={c}>
          <a class="tile" href={pi(c, n)} aria-label={item.title}>
            <img src={pi(c, n)} alt={item.title} loading="lazy" />
            <span class="tile__caption">
              <span class="tile__cat">{c.charAt(0).toUpperCase() + c.slice(1)}</span>
              <span class="tile__title">{item.title}</span>
            </span>
          </a>
        </figure>
      );
    })}
  </div>

  <section class="about" id="o-mnie">
    <div class="wrap about__grid">
      <div class="about__img">
        <img src={ki('manifesto.jpg')} alt="Anna Matejska-Gazda" loading="lazy" />
      </div>
      <div class="about__body">
        <div class="eyebrow">O mnie</div>
        <h2>Fotografka z Krakowa</h2>
        <p>Jestem fotografką z Krakowa. Najbardziej lubię pracować z lokalnymi markami, organizacjami społecznymi i placówkami kultury — z ludźmi, którzy robią coś ważnego w swojej okolicy.</p>
        <p>Fotografuję wydarzenia, architekturę i podróże. Zależy mi na naturalnym świetle, prawdziwych momentach i ludziach, którzy nie pozują na siłę.</p>
        <p style="font-family:var(--serif);color:var(--taupe);font-size:0.95rem;margin-top:1.5rem">Anna Matejska-Gazda</p>
      </div>
    </div>
  </section>

  <section class="process" id="wspolpraca" style="background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:4rem 0">
    <div class="wrap">
      <div class="section-label" style="padding-top:0">
        <h2>Jak to wygląda</h2>
        <p>Prosto i bez biurokracji</p>
      </div>
      <div class="process__grid">
        <div class="process__step">
          <span class="process__num">01</span>
          <h3>Rozmowa &amp; wycena</h3>
          <p>Bezpłatna rozmowa o tym, co chcesz pokazać. Wycena w 48h — bez ukrytych kosztów.</p>
        </div>
        <div class="process__step">
          <span class="process__num">02</span>
          <h3>Zdjęcia &amp; prawa</h3>
          <p>Przekazuję pliki z jasną licencją — na stronę, social media, katalogi. Wszystko na piśmie.</p>
        </div>
        <div class="process__step">
          <span class="process__num">03</span>
          <h3>Termin &amp; realizacja</h3>
          <p>Sesja w 2–3 tygodnie od akceptacji; wybrane pliki w 7–14 dni. Pilne — do uzgodnienia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="kontakt" style="padding:4rem 0 2rem">
    <div class="wrap contact__inner">
      <div>
        <div class="eyebrow">Kontakt</div>
        <h2 style="font-weight:300;font-size:clamp(1.3rem,2.5vw,1.8rem);margin-bottom:2rem">Porozmawiajmy<br>o Twoim projekcie</h2>
        <ul class="contact__list">
          <li><span class="contact__label">Telefon</span><a href="tel:+486002478474">602 782 474</a></li>
          <li><span class="contact__label">E-mail</span><a href="mailto:annamatejskagazda@gmail.com">annamatejskagazda@gmail.com</a></li>
          <li><span class="contact__label">Instagram</span><a href="https://www.instagram.com/annamatejska.fotografia/" target="_blank" rel="noopener">@annamatejska.fotografia</a></li>
        </ul>
      </div>
      <div>
        <form id="contact-form" class="form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="6b55969b-bf3d-4f40-944d-c030a292f69a" />
          <input type="hidden" name="subject" value="Nowa wiadomość z kadrowania" />
          <input type="hidden" name="from_name" value="Formularz kadrowania" />
          <div class="form__group">
            <label class="form__label" for="fn">Imię i nazwisko</label>
            <input type="text" id="fn" name="name" class="form__input" required placeholder="Jak masz na imię?" />
          </div>
          <div class="form__group">
            <label class="form__label" for="fe">E-mail</label>
            <input type="email" id="fe" name="email" class="form__input" required placeholder="Twój adres e-mail" />
          </div>
          <div class="form__group">
            <label class="form__label" for="fm">Wiadomość</label>
            <textarea id="fm" name="message" class="form__textarea" required rows="3" placeholder="Opisz krótko czego potrzebujesz"></textarea>
          </div>
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div class="h-captcha" data-captcha="true" style="margin-bottom:1rem"></div>
          <button type="submit" class="btn form__submit">Wyślij wiadomość</button>
          <p class="form__status" aria-live="polite" style="margin-top:0.5rem;font-size:0.85rem"></p>
        </form>
      </div>
    </div>
  </section>
</KadrowaniaLayout>

<script is:inline src="https://js.hcaptcha.com/1/api.js" defer></script>