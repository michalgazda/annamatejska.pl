---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ofertaNgo, site } from '../data/queries';

const base = import.meta.env.BASE_URL;
const n = ofertaNgo();
const s = site();
---

<BaseLayout title="Oferta NGO — fotograf na wydarzenia organizacji | Anna Matejska-Gazda Kraków" description="Reportaże fotograficzne dla organizacji pozarządowych i grup nieformalnych: konferencje, warsztaty, koncerty, rekolekcje, festyny. Indywidualna oferta współpracy.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{n.kicker}</span>
      <h1 class="page-title">{n.title}</h1>
      <p class="lead" style="max-width:760px;margin:18px auto 0">{n.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container split">
      <div class="prose">
        <h2 class="group-title" style="margin-bottom:18px">{n.events_title}</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {n.events.map(e => <li>{e}</li>)}
        </ul>
      </div>
      <div class="prose">
        <h2 class="group-title" style="margin-bottom:18px">{n.start_title}</h2>
        {n.paragraphs.map(p => <p>{p}</p>)}
        <p style="font-size:.9rem;color:var(--taupe)">{n.note} {s.phoneDisplay}.</p>
        <p style="margin-top:26px"><a href={`${base}kontakt`} class="btn btn-taupe">{n.cta_button}</a></p>
      </div>
    </div>
  </section>

  <section class="quote">
    <div class="container prose prose-narrow">
      <p style="margin-bottom:18px">{n.examples} <a href={`${base}reportaze`} style="color:var(--taupe);border-bottom:1px solid var(--taupe)">{n.examples_link_label}</a>.</p>
      <p style="font-size:.9rem;color:var(--ink-soft)">E-mail: <a href={`mailto:${s.email}`} style="color:var(--taupe)">{s.email}</a></p>
    </div>
  </section>
</BaseLayout>
