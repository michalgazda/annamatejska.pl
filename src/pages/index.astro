---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonMotif from '../components/SeasonMotif.astro';
import { services, testimonials, assetPath, home, sezony, instagram } from '../data/queries';

const base = import.meta.env.BASE_URL;
const svcs = services();
const testis = testimonials();
const h = home().about;
const se = sezony();
const ig = instagram();
---

<BaseLayout title="Anna Matejska-Gazda — Fotograf Kraków | Sesje rodzinne, kobiece i portretowe" description="Naturalna fotografia rodzinna, kobieca, ciążowa i wizerunkowa w Krakowie. Bez pozowania, z czułością.">
  <!-- Hero — script signature + FOTOGRAFIA, jak na starej stronie -->
  <section class="hero">
    <img class="bg" src={`${base}images/hero.jpg`} alt="Sesja rodzinna w plenerze pod Krakowem — dwie dziewczynki idące ścieżką wśród kwitnących drzew" fetchpriority="high" />
    <div class="hero-inner">
      <h1>
        <span class="script-name">Anna Matejska-Gazda</span>
        <span class="hero-word">Fotografia</span>
        <span class="sr-only">— fotograf rodzinny, kobiecy, ciążowy i wizerunkowy w Krakowie i okolicach</span>
      </h1>
      <span class="hero-rule"></span>
      <p>Naturalnie · Uważnie · z czułością</p>
    </div>
  </section>

  <!-- Sesje / oferta -->
  <section class="services" id="sesje">
    <div class="container">
      <div class="gal-head">
        <div>
          <span class="kicker">Oferta</span>
          <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">Wybierz swoją sesję</h2>
        </div>
        <a href={`${base}kontakt`} class="btn btn-taupe-line">Zapytaj o termin</a>
      </div>
      <div class="svc-grid">
        {svcs.map(s => (
          <a class="svc" href={`${base}sesje/${s.slug}`}>
            <span class="thumb"><img src={assetPath(s.card_image, base)} alt={`Sesje ${s.card_title} Kraków`} loading="lazy" /></span>
            <h3>{s.card_title}</h3>
            <p>{s.card_short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cytat -->
  <section class="quote">
    <div class="container">
      <blockquote>„W doskonałej fotografii chodzi o głębię uczucia,<br>nie o głębię ostrości.”</blockquote>
      <cite>Peter Adams</cite>
    </div>
  </section>

  <!-- O mnie -->
  <section id="o-mnie">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={assetPath(h.photo, base)} alt="Anna Matejska-Gazda — fotografka z Krakowa" loading="lazy" />
      </div>
      <div>
        <span class="kicker">{h.kicker}</span>
        <h2 class="script" style="font-size:clamp(1.9rem,3.6vw,2.7rem);color:var(--taupe)">
          {h.script_heading.split(/(?<=!)\s+/).map((line, i) => <>{i > 0 && <br />}{line}</>)}
        </h2>
        {h.paragraphs.map(p => <p style="color:var(--ink-soft)">{p}</p>)}
        <p style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
          <a href={`${base}o-mnie`} class="btn btn-line">Więcej o mnie</a>
          <a href={assetPath(h.button_url, base)} class="btn btn-line">{h.button_label}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Pory roku -->
  <section class="seasons">
    <div class="container">
      <span class="kicker">{se.kicker}</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">{se.title}</h2>
      <p style="margin-top:14px;color:var(--ink-soft)">{se.lead}</p>
      <div class="season-slider">
        <div class="season-track" id="season-track" tabindex="0" aria-label="Sezonowe plenery — przewiń w lewo lub w prawo">
          {se.seasons.map(s => (
            <article class={`season-card${s.image ? '' : ' season-card--text'}`}>
              {s.image
                ? <img src={assetPath(s.image, base)} alt={s.alt || s.name} loading="lazy" width="900" height="600" />
                : <div class="season-ph"><SeasonMotif name={s.motif} /></div>}
              <div class="season-body">
                <span class="mo">{s.period}</span>
                <h3>{s.name}</h3>
              </div>
            </article>
          ))}
        </div>
        <div class="season-nav">
          <button type="button" class="season-prev" aria-label="Poprzednie plenery" aria-controls="season-track">‹</button>
          <button type="button" class="season-next" aria-label="Następne plenery" aria-controls="season-track">›</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Proces -->
  <section id="jak-to-dziala">
    <div class="container">
      <span class="kicker">Proces</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">Jak to działa?</h2>
      <div class="process-grid">
        <div class="step"><div class="step-num">01</div><h3>Rozmowa</h3><p>Poznajmy się! Rozmawiamy o Waszych oczekiwaniach, miejscu i stylu sesji.</p></div>
        <div class="step"><div class="step-num">02</div><h3>Przygotowanie</h3><p>Pomogę w doborze strojów, miejsca i pory dnia — idealnej na Wasze zdjęcia.</p></div>
        <div class="step"><div class="step-num">03</div><h3>Sesja</h3><p>Bez presji pozowania. Spacer, zabawa, swoboda — ja łapię momenty pomiędzy.</p></div>
        <div class="step"><div class="step-num">04</div><h3>Zdjęcia</h3><p>Starannie wyselekcjonowana i obrobiona galeria — zwykle w ciągu kilku dni.</p></div>
      </div>
    </div>
  </section>

  <!-- Masz pytania? -->
  <section class="cta-band">
    <img class="bg" src={`${base}images/cta.jpg`} alt="" loading="lazy" aria-hidden="true" />
    <div class="container inner">
      <h2>Masz pytania?</h2>
      <p>Jeśli masz jakieś pytania odnośnie sesji fotograficznej lub reportażu,<br>odezwij się — na wszystkie odpowiem.</p>
      <a href={`${base}kontakt`} class="btn btn-white">Napisz do mnie</a>
    </div>
  </section>

  <!-- Opinie — jedna opinia naraz, crossfade jak u Agnieszki Relic (Slick fade:true) -->
  <section id="opinie" style="background:var(--white)">
    <div class="container">
      <span class="kicker">Opinie</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">Wasze słowa o naszych fotograficznych spotkaniach</h2>
    </div>
    <div class="container">
      <div class="testi-slider" role="region" aria-label="Opinie klientów" tabindex="0">
        <div class="testi-stack" id="testi-stack">
          {testis.map((t, i) => (
            <article class={`testi-slide${i === 0 ? ' is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
              <figure class="testi-photo">
                {t.photo
                  ? <img src={assetPath(t.photo, base)} alt={`Opinia — ${t.author}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  : <span class="testi-initial" aria-hidden="true">{t.author.slice(0, 1)}</span>}
              </figure>
              <div class="testi-body">
                <blockquote>„{t.quote}”</blockquote>
                <p class="testi-author">{t.author}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="testi-nav">
          <button type="button" class="testi-prev" aria-label="Poprzednia opinia">‹</button>
          <button type="button" class="testi-next" aria-label="Następna opinia">›</button>
        </div>
      </div>
      <p class="testi-count" aria-live="polite"><span id="testi-cur">1</span> / {testis.length}</p>
    </div>
  </section>

  <!-- Instagram — na całą szerokość, dwa rzędy po 6 kwadratów (jak na starej stronie) -->
  <section id="instagram" class="ig-section">
    <div class="container">
      <span class="kicker">Instagram</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">
        <a href={ig.profile_url} target="_blank" rel="noopener">{ig.profile}</a>
      </h2>
    </div>
    <div class="ig-grid">
      {ig.items.map((it) => (
        <a class="ig-item" href={it.url} target="_blank" rel="noopener nofollow" aria-label="Zobacz to zdjęcie na Instagramie">
          <img src={assetPath(it.photo, base)} alt="" width="600" height="600" loading="lazy" decoding="async" />
          <span class="ig-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect><circle cx="12" cy="12" r="4.4"></circle><circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" stroke="none"></circle></svg>
          </span>
        </a>
      ))}
    </div>
    <div class="container ig-links">
      <a class="ig-more" href={ig.profile_url} target="_blank" rel="noopener">{ig.load_more_label}</a>
      <a class="ig-follow" href={ig.profile_url} target="_blank" rel="noopener">{ig.follow_label}</a>
    </div>
  </section>
</BaseLayout>
