---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGroup from '../components/GalleryGroup.astro';
import { reportaze, site, galleries, assetPath, pageHeading } from '../data/queries';

const base = import.meta.env.BASE_URL;
const r = reportaze();
const s = site();
const reportageGalleries = galleries().filter(g => g.category === 'Reportaże');
const galBySlug = Object.fromEntries(reportageGalleries.map(g => [g.slug, g]));
// Grupy reportaży z kartami galerii (okładki jak na starej stronie) + pozycje bez galerii
const groups = r.groups.map(g => ({
  title: g.title,
  cards: g.items.filter(i => i.slug && galBySlug[i.slug]).map(i => ({ title: i.title, slug: i.slug, cover: galBySlug[i.slug].cover })),
  plain: g.items.filter(i => !(i.slug && galBySlug[i.slug])).map(i => i.title),
}));
// opinia przenoszona pod pierwszą grupę (Ania 2026-10): bez „bottom” → pasmo po opisie
const opinionsTop = (r.testimonials || []).filter(t => !t.bottom);
const opinionsInline = (r.testimonials || []).filter(t => t.bottom);
---

<BaseLayout title="Reportaże — chrzest, komunia, ślub, wydarzenia | Anna Matejska-Gazda Kraków" description="Reportaże fotograficzne z uroczystości rodzinnych (chrzest, komunia, ślub, rocznice) oraz z wydarzeń społecznych i kulturalnych — Kraków i okolice.">
  <section class="page-hero">
    <div class="container">
      <h1 class="kicker">{pageHeading(r.kicker, r.title)}</h1>
      <p class="lead" style="max-width:720px;margin:0 auto">{r.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container grid-2">
      <div>
        <h2 style="font-size:.86rem;letter-spacing:.24em;text-transform:uppercase">Reportaże — uroczystości rodzinne</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {r.family.map(f => <li>{f}</li>)}
        </ul>
      </div>
      <div>
        <h2 style="font-size:.86rem;letter-spacing:.24em;text-transform:uppercase">Wydarzenia społeczne i komercyjne</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {r.events.map(e => <li>{e}</li>)}
        </ul>
        <p style="margin-top:26px;color:var(--ink-soft);font-size:.94rem">Pracujesz w organizacji pozarządowej albo grupie nieformalnej? Zobacz <a href={`${base}oferta-ngo`} style="color:var(--taupe);border-bottom:1px solid var(--taupe)">ofertę NGO</a>.</p>
      </div>
    </div>
  </section>

  <section class="quote opinion">
    <div class="container">
      {opinionsTop.map(t => (
        <figure class="opinion-item">
          <blockquote>„{t.quote}”</blockquote>
          <p class="opinion-author">{t.author}</p>
        </figure>
      ))}
    </div>
  </section>

  <section style="background:var(--white)">
    <div class="container">
      <span class="kicker">Portfolio</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">Wybrane realizacje</h2>
      <GalleryGroup group={groups[0]} base={base} />
    </div>
  </section>

  {opinionsInline.length > 0 && (
    <section class="quote opinion">
      <div class="container">
        {opinionsInline.map(t => (
          <figure class="opinion-item">
            <blockquote>„{t.quote}”</blockquote>
            <p class="opinion-author">{t.author}</p>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section style="background:var(--white)">
    <div class="container">
      {groups.slice(1).map(g => <GalleryGroup group={g} base={base} />)}
    </div>
  </section>

  <section class="quote" style="padding:96px 0">
    <div class="container">
      <h2 class="script" style="font-size:clamp(1.9rem,4vw,2.6rem);color:var(--taupe);margin-bottom:14px">Masz pytania?</h2>
      <p style="max-width:760px;margin:0 auto 26px;color:var(--ink-soft)">W zależności od lokalizacji, czasu trwania wydarzenia oraz Waszych potrzeb przygotowuję indywidualną ofertę. Każda oferta ma 3 propozycje pakietów do wyboru.</p>
      <p><a href={`${base}kontakt`} class="btn btn-taupe">Napisz do mnie</a></p>
      <p style="margin-top:22px;font-size:.9rem;color:var(--ink-soft)">{s.email} · {s.phoneDisplay}</p>
    </div>
  </section>
</BaseLayout>
