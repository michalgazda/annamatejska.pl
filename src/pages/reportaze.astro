---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reportaze, site, galleries, assetPath, pageHeading } from '../data/queries';

const base = import.meta.env.BASE_URL;
const r = reportaze();
const s = site();
const reportageGalleries = galleries().filter(g => g.category === 'Reportaże');
---

<BaseLayout title="Reportaże — chrzest, komunia, ślub, wydarzenia | Anna Matejska-Gazda Kraków" description="Reportaże fotograficzne z uroczystości rodzinnych (chrzest, komunia, ślub, rocznice) oraz z wydarzeń społecznych i kulturalnych — Kraków i okolice.">
  <section class="page-hero">
    <div class="container">
      <h1 class="kicker">{pageHeading(r.kicker, r.title)}</h1>
      <p class="lead" style="max-width:720px;margin:0 auto">{r.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container grid-2">
      <div>
        <h2 style="font-size:.86rem;letter-spacing:.24em;text-transform:uppercase">Reportaże — uroczystości rodzinne</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {r.family.map(f => <li>{f}</li>)}
        </ul>
      </div>
      <div>
        <h2 style="font-size:.86rem;letter-spacing:.24em;text-transform:uppercase">Wydarzenia społeczne i komercyjne</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {r.events.map(e => <li>{e}</li>)}
        </ul>
        <p style="margin-top:26px;color:var(--ink-soft);font-size:.94rem">Pracujesz w organizacji pozarządowej albo grupie nieformalnej? Zobacz <a href={`${base}oferta-ngo`} style="color:var(--taupe);border-bottom:1px solid var(--taupe)">ofertę NGO</a>.</p>
      </div>
    </div>
  </section>

  <section class="quote opinion">
    <div class="container">
      {r.testimonials.map(t => (
        <figure class="opinion-item">
          <blockquote>„{t.quote}”</blockquote>
          <p class="opinion-author">{t.author}</p>
        </figure>
      ))}
    </div>
  </section>

  <section style="background:var(--white)">
    <div class="container">
      <span class="kicker">Portfolio</span>
      <h2 style="font-size:clamp(1.7rem,3.2vw,2.4rem)">Wybrane realizacje</h2>
      {r.groups.map(g => (
        <div style="margin-top:44px">
          <h3 class="group-title">{g.title}</h3>
          <ul class="link-list">
            {g.items.map(i => (
              <li>
                {i.slug ? (
                  <a href={`${base}galerie/${i.slug}`} style="display:flex;justify-content:space-between;gap:14px;align-items:baseline">
                    <span>{i.title}</span>
                    <span style="color:var(--taupe);font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap">galeria →</span>
                  </a>
                ) : <span>{i.title}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
      {reportageGalleries.length > 0 && (
        <div class="gal-list" style="margin-top:44px">
          {reportageGalleries.map(g => (
            <a class="gal-card" href={`${base}galerie/${g.slug}`}>
              <img src={assetPath(g.cover, base)} alt={g.title} loading="lazy" />
              <div class="overlay"><h3>{g.title}</h3></div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="cta-band">
    <img class="bg" src={`${base}images/cta.jpg`} alt="" aria-hidden="true" loading="lazy" />
    <div class="container inner">
      <h2>Masz pytania?</h2>
      <p>W zależności od lokalizacji, czasu trwania wydarzenia oraz Waszych potrzeb przygotowuję indywidualną ofertę. Każda oferta ma 3 propozycje pakietów do wyboru.</p>
      <a href={`${base}kontakt`} class="btn btn-white">Napisz do mnie</a>
      <p style="margin-top:22px;font-size:.9rem;opacity:.9">{s.email} · {s.phoneDisplay}</p>
    </div>
  </section>
</BaseLayout>
