---
import BaseLayout from '../layouts/BaseLayout.astro';
import { oferta, vouchery, site } from '../data/queries';

const base = import.meta.env.BASE_URL;
const v = vouchery();
const s = site();
const o = oferta();
const sessionPackages = o.groups[0].packages.concat(o.groups[1].packages.slice(0, 1));
---

<BaseLayout title="Vouchery prezentowe — sesja fotograficzna w prezencie | Anna Matejska-Gazda" description="Voucher prezentowy na sesję fotograficzną w Krakowie: dowolny pakiet w tej samej cenie, ważność 365 dni, możliwa wysyłka InPostem.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{v.kicker}</span>
      <h1 class="page-title">{v.title}</h1>
      <p class="lead" style="max-width:760px;margin:18px auto 0">{v.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container grid-2" style="align-items:start">
      <div class="prose reveal reveal-up">
        <h2 class="group-title" style="margin-bottom:18px">{v.how_title}</h2>
        <ul class="link-list" style="grid-template-columns:1fr">
          {v.how.map(x => <li>{x}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="group-title" style="margin-bottom:18px">{v.packages_title}</h2>
        <div class="price-grid" style="grid-template-columns:repeat(2,1fr);margin-top:0">
          {sessionPackages.map(p => (
            <article class="price-card reveal reveal-up" style="padding:30px 24px">
              <span class="price-name">{p.name}</span>
              <span class="price-amount" style="font-size:2rem">{p.price}</span>
              <p style="font-size:.8rem;color:var(--ink-soft)">{p.features[0].replace(/\*\*/g, '')}</p>
            </article>
          ))}
        </div>
        <p class="price-note" style="text-align:left">Pełny opis pakietów znajdziesz w zakładce <a href={`${base}oferta`} style="color:var(--taupe);border-bottom:1px solid var(--taupe)">Oferta</a>.</p>
      </div>
    </div>
  </section>

  <section class="quote" style="text-align:center">
    <div class="container" style="max-width:760px">
      <h2 class="script" style="font-size:clamp(1.7rem,3.2vw,2.4rem);color:var(--taupe);margin-bottom:14px">{v.cta_title}</h2>
      <p style="color:var(--ink-soft);margin-bottom:26px">{v.cta_text}</p>
      <a href={`${base}kontakt`} class="btn btn-line">{v.cta_button}</a>
      <p style="margin-top:22px;font-size:.9rem;color:var(--ink-soft)">{s.email} · {s.phoneDisplay}</p>
    </div>
  </section>
</BaseLayout>
