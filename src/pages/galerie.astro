---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleries, formatDate, assetPath } from '../data/queries';

const base = import.meta.env.BASE_URL;
const allGalleries = galleries();
---

<BaseLayout title="Galerie — Anna Matejska-Gazda Fotograf Kraków" description="Portfolio — galerie sesji rodzinnych, kobiecych, ciążowych i wizerunkowych.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Portfolio</span>
      <h1>Galerie</h1>
      <p>Wybrane sesje — każda inna historia. Kliknij, żeby zobaczyć całą galerię.</p>
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="container">
      <h2 class="sr-only">Lista galerii</h2>
      <div class="gal-list">
        {allGalleries.map(g => (
          <a class="gal-card" href={`${base}galerie/${g.slug}`}>
            <img src={assetPath(g.cover, base)} alt={g.title} loading="lazy" />
            <div class="overlay"><h3>{g.title}</h3><p>{g.excerpt}</p><time>{formatDate(g.date)}</time></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>