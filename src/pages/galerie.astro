---
import BaseLayout from '../layouts/BaseLayout.astro';
import { assetPath, portfolio } from '../data/queries';

const base = import.meta.env.BASE_URL;
const selected = portfolio();
---

<BaseLayout title="Portfolio — wybrane zdjęcia | Anna Matejska-Gazda Fotograf Kraków" description="Wybrane zdjęcia z sesji rodzinnych, kobiecych, ciążowych, wizerunkowych i reportaży. Portfolio Anny Matejskiej-Gazdy, fotograf z Krakowa.">
  <section class="page-hero" style="padding:150px 0 34px">
    <div class="container">
      <span class="kicker" style="margin-bottom:0">Portfolio</span>
      <h1 class="sr-only">Portfolio — wybrane zdjęcia Anny Matejskiej-Gazdy, fotograf Kraków</h1>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container">
      <div class="portfolio-grid">
        {selected.map((p, i) => (
          <figure>
            <img
              src={assetPath(p.thumb || p.photo, base)}
              data-full={assetPath(p.photo, base)}
              alt={p.alt || `Wybrane zdjęcie ${i + 1} — Anna Matejska-Gazda Fotografia`}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
