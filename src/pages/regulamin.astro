---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regulamin, site, pageHeading } from '../data/queries';

const base = import.meta.env.BASE_URL;
const r = regulamin();
const s = site();
---

<BaseLayout title="Regulamin i polityka prywatności — Anna Matejska-Gazda Fotografia" description="Regulamin usług fotograficznych: rezerwacja sesji, retusz, przenoszenie terminów, prawa autorskie, reklamacje oraz informacje RODO.">
  <section class="page-hero">
    <div class="container">
      <h1 class="kicker">{pageHeading(r.kicker, r.title)}</h1>
      <p class="lead" style="max-width:760px;margin:18px auto 0">{r.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container legal">
      <h2>{r.rules_title}</h2>
      <ul>
        {r.rules.map(x => <li>{x}</li>)}
      </ul>

      <h2>{r.complaints_title}</h2>
      <ul>
        {r.complaints.map(x => <li>{x}</li>)}
      </ul>

      <h2>{r.rodo_title}</h2>
      <p>{r.rodo_intro}</p>
      {r.rodo_blocks.map(b => (
        <>
          <h3>{b.title}</h3>
          <ul>
            {b.paragraphs.map(p => <li>{p}</li>)}
          </ul>
        </>
      ))}
      <p style="margin-top:20px">Kontakt w sprawie danych osobowych: <a href={`mailto:${s.email}`} style="color:var(--taupe)">{s.email}</a>, tel. {s.phoneDisplay}.</p>

      <p style="margin-top:36px"><a href={`${base}polityka-prywatnosci`} class="btn btn-line">{r.privacy_button}</a></p>
    </div>
  </section>
</BaseLayout>
