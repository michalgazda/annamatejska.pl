---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutPage, site, assetPath } from '../data/queries';

const base = import.meta.env.BASE_URL;
const a = aboutPage();
const s = site();
---

<BaseLayout title="O mnie — Anna Matejska-Gazda, fotograf Kraków" description="Mam na imię Anna. Historyk sztuki i pedagog, żona i mama dwóch córeczek. Fotografia rodzinna, kobieca i portretowa w Krakowie — czułość, estetyka i dobra kawa.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{a.kicker}</span>
      <h1 class="page-title">O mnie</h1>
      <p class="lead" style="max-width:820px;margin:18px auto 0">{a.script_heading}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container split">
      <figure class="fig-portrait reveal reveal-left" style="margin:0">
        <img src={assetPath(a.photo, base)} alt="Anna Matejska-Gazda — fotografka z Krakowa" />
      </figure>
      <div class="prose reveal reveal-right">
        <p class="lead">{a.intro}</p>
        {a.sections.map(sec => (
          <div style="margin-top:34px">
            <h2 class="sub-title" style="margin-bottom:12px">{sec.title}</h2>
            {sec.paragraphs.map(p => <p>{p}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band" style="padding:96px 0">
    <img class="bg" src={`${base}images/cta.jpg`} alt="" aria-hidden="true" loading="lazy" />
    <div class="container inner">
      <h2>{a.cta_title}</h2>
      <p>{a.cta_text}</p>
      <a href={`${base}kontakt`} class="btn btn-white">Napisz do mnie</a>
      <p style="margin-top:22px;font-size:.9rem;opacity:.9">{s.email} · {s.phoneDisplay}</p>
    </div>
  </section>
</BaseLayout>
