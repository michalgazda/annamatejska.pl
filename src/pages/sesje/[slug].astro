---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, galleries, sesje, assetPath, pageHeading } from '../../data/queries';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const all = services();
  const allGalleries = galleries();
  const sessionData = Object.fromEntries(sesje().map(x => [x.slug, x]));
  return all.map(s => ({
    params: { slug: s.slug },
    props: {
      service: s,
      session: sessionData[s.slug] || { hero: '', photos: [], samples_title: '', samples: [] },
      sampleGalleries: (sessionData[s.slug]?.samples || [])
        .map(item => ({ item, gallery: allGalleries.find(g => g.slug === item.slug) }))
        .filter(x => x.gallery),
    },
  }));
}

const { service, session, sampleGalleries } = Astro.props;

// odmiana przez przypadki (polskie końcówki) — inaczej wychodzi „Zdjęcia z sesji romantyczne”
const FORMS = {
  romantyczne: ['romantycznych', 'romantyczną'],
  rodzinne: ['rodzinnych', 'rodzinną'],
  dzieciece: ['dziecięcych', 'dziecięcą'],
  kobiece: ['kobiecych', 'kobiecą'],
  ciazowe: ['ciążowych', 'ciążową'],
  wizerunkowe: ['wizerunkowych', 'wizerunkową'],
};
const [genitivePlural, accusativeSingular] = FORMS[service.slug] || [service.card_title.toLowerCase(), service.card_title.toLowerCase()];

// Opinie tej sesji — może ich być kilka (np. kobiece mają dwie, jak na starej stronie)
const opinions = service.opinions || [];
---

<BaseLayout title={`Sesje ${service.card_title} Kraków – naturalne zdjęcia | Anna Matejska-Gazda`} description={service.subtitle} image={session.hero || undefined}>
  <section class="page-hero" style="padding-bottom:40px">
    <div class="container session-intro">
      {session.hero && (
        <figure class="session-photo reveal reveal-left">
          <img src={assetPath(session.hero, base)} alt={`${service.title} — Anna Matejska-Gazda, Kraków`} fetchpriority="high" />
        </figure>
      )}
      <div class="session-text reveal reveal-right">
        <h1 class="kicker">{pageHeading(`${service.category} · ${service.tagline}`, service.title)}</h1>
        <p class="lead">{service.subtitle}</p>
        {service.description.map(p => <p style="color:var(--ink-soft);margin-bottom:1rem">{p}</p>)}
        <p class="session-duration">Czas trwania: {service.duration}</p>
        <a class="btn btn-taupe" href={`${base}kontakt`}>Umów tę sesję</a>
      </div>
    </div>
  </section>

  <section class="quote opinion" style="padding:72px 0">
    <div class="container">
      {opinions.map(o => (
        <figure class="opinion-item">
          <blockquote>„{o.text}”</blockquote>
          <p class="opinion-author">{o.author}</p>
        </figure>
      ))}
    </div>
  </section>

  {session.photos.length > 0 && (
    <section style="padding-top:56px">
      <div class="container">
        <span class="kicker">Galeria</span>
        <h2 class="sub-title" style="margin-bottom:26px">Zdjęcia z sesji {genitivePlural}</h2>
        <div class="photo-grid" style="margin-top:0">
          {session.photos.map((p, i) => (
            <figure>
              <img src={assetPath(p.thumb || p.photo, base)} data-full={assetPath(p.photo, base)}
                   alt={`${service.title} — zdjęcie ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {sampleGalleries.length > 0 && (
    <section style="background:var(--white)">
      <div class="container">
        <h2 class="sub-title" style="color:var(--taupe);margin-bottom:26px">{session.samples_title}</h2>
        <div class={`gal-list${session.samples_landscape ? ' gal-list--wide' : ''}`} style="margin-top:0">
          {sampleGalleries.map(({ item, gallery }) => (
            <a class="gal-card" href={`${base}galerie/${gallery.slug}`}>
              <img src={assetPath(gallery.cover, base)} alt={item.title || gallery.title} loading="lazy" />
              <div class="overlay">
                <h3>{item.title || gallery.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:0" >
    <div class="container" style="text-align:center">
      <a class="btn btn-taupe" href={`${base}kontakt`}>Umów sesję {accusativeSingular}</a>
    </div>
  </section>
</BaseLayout>
