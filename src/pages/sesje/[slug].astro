---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, galleries, formatDate, assetPath } from '../../data/queries';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const allServices = services();
  return allServices.map(s => ({
    params: { slug: s.slug },
    props: { service: s, categoryGalleries: galleries().filter(g => g.category === s.category) },
  }));
}

const { service, categoryGalleries } = Astro.props;
---

<BaseLayout title={`Sesje ${service.card_title} Kraków – naturalne zdjęcia | Anna Matejska-Gazda`} description={service.subtitle}>
  <section class="page-hero">
    <div class="container gal-meta">
      <span class="kicker">{service.category} · {service.tagline}</span>
      <h1>{service.title}</h1>
      <p>{service.subtitle}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container" style="max-width:820px">
      {service.description.map(p => <p style="color:var(--ink-soft);margin-bottom:1rem">{p}</p>)}
      <div style="display:flex;gap:40px;flex-wrap:wrap;margin-top:36px;padding:26px 32px;border:1px solid var(--line);border-radius:3px;background:var(--white)">
        <div><span class="kicker" style="margin-bottom:.3rem">Czas trwania</span><strong style="font-family:var(--serif);font-size:1.5rem;font-weight:500">{service.duration}</strong></div>
        <div style="flex:1;min-width:240px"><span class="kicker" style="margin-bottom:.3rem">Zawsze w cenie</span><span style="color:var(--ink-soft);font-size:.92rem">{service.included}</span></div>
      </div>
      <blockquote style="font-family:var(--quote);font-size:1.4rem;line-height:1.55;color:var(--taupe);border-left:2px solid var(--taupe);padding-left:24px;margin:52px 0">{service.quote}</blockquote>
    </div>
  </section>

  {categoryGalleries.length > 0 && (
    <section style="background:var(--white)">
      <div class="container">
        <span class="kicker">Galerie</span>
        <h2 class="sub-title" style="margin-bottom:8px">Sesje {service.card_title.toLowerCase()} — galerie</h2>
        <p style="color:var(--ink-soft)">Kliknij, żeby zobaczyć całą galerię.</p>
        <div class="gal-list">
          {categoryGalleries.map(g => (
            <a class="gal-card" href={`${base}galerie/${g.slug}`}>
              <img src={assetPath(g.cover, base)} alt={g.title} loading="lazy" />
              <div class="overlay"><h3>{g.title}</h3><p>{g.excerpt}</p><time>{formatDate(g.date)}</time></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:0">
    <div class="container" style="text-align:center">
      <a class="btn btn-taupe" href={`${base}kontakt`}>Umów tę sesję</a>
    </div>
  </section>
</BaseLayout>
