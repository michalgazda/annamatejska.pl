---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, galleries, sesje, formatDate, assetPath } from '../../data/queries';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const all = services();
  const allGalleries = galleries();
  const sessionData = Object.fromEntries(sesje().map(x => [x.slug, x]));
  return all.map(s => ({
    params: { slug: s.slug },
    props: {
      service: s,
      session: sessionData[s.slug] || { hero: '', photos: [], samples_title: '', samples: [] },
      sampleGalleries: (sessionData[s.slug]?.samples || [])
        .map(item => ({ item, gallery: allGalleries.find(g => g.slug === item.slug) }))
        .filter(x => x.gallery),
    },
  }));
}

const { service, session, sampleGalleries } = Astro.props;
---

<BaseLayout title={`Sesje ${service.card_title} Kraków – naturalne zdjęcia | Anna Matejska-Gazda`} description={service.subtitle} image={session.hero || undefined}>
  <section class="page-hero" style="padding-bottom:40px">
    <div class="container session-intro">
      {session.hero && (
        <figure class="session-photo reveal reveal-left">
          <img src={assetPath(session.hero, base)} alt={`Sesje ${service.card_title} — Anna Matejska-Gazda, Kraków`} fetchpriority="high" />
        </figure>
      )}
      <div class="session-text reveal reveal-right">
        <span class="kicker">{service.category} · {service.tagline}</span>
        <h1 class="page-title">{service.title}</h1>
        <p class="lead">{service.subtitle}</p>
        {service.description.map(p => <p style="color:var(--ink-soft);margin-bottom:1rem">{p}</p>)}
        <div class="session-meta">
          <div>
            <span class="kicker" style="margin-bottom:0">Czas trwania</span>
            <strong>{service.duration}</strong>
          </div>
          <div class="inc">
            <span class="kicker" style="margin-bottom:0">Zawsze w cenie</span>
            {service.included}
          </div>
        </div>
        <a class="btn btn-taupe" href={`${base}kontakt`}>Umów tę sesję</a>
      </div>
    </div>
  </section>

  {session.photos.length > 0 && (
    <section style="padding-top:0">
      <div class="container">
        <span class="kicker">Galeria</span>
        <h2 class="sub-title" style="margin-bottom:6px">Zdjęcia z sesji {service.card_title.toLowerCase()}</h2>
        <p style="color:var(--ink-soft);margin-bottom:8px">Kliknij zdjęcie, żeby powiększyć.</p>
        <div class="photo-grid">
          {session.photos.map((p, i) => (
            <figure>
              <img src={assetPath(p.thumb || p.photo, base)} data-full={assetPath(p.photo, base)}
                   alt={`Sesja ${service.card_title} — zdjęcie ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {sampleGalleries.length > 0 && (
    <section style="background:var(--white)">
      <div class="container">
        <h2 class="sub-title" style="margin-bottom:26px">{session.samples_title}</h2>
        <div class="gal-list" style="margin-top:0">
          {sampleGalleries.map(({ item, gallery }) => (
            <a class="gal-card" href={`${base}galerie/${gallery.slug}`}>
              <img src={assetPath(gallery.cover, base)} alt={item.title || gallery.title} loading="lazy" />
              <div class="overlay">
                <h3>{item.title || gallery.title}</h3>
                <p>{gallery.excerpt}</p>
                <time>{formatDate(gallery.date)}</time>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="quote" style="padding:72px 0">
    <div class="container">
      <blockquote>{service.quote}</blockquote>
    </div>
  </section>

  <section style="padding-top:0" >
    <div class="container" style="text-align:center">
      <a class="btn btn-taupe" href={`${base}kontakt`}>Umów sesję {service.card_title.toLowerCase()}</a>
    </div>
  </section>
</BaseLayout>
