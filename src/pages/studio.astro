---
import BaseLayout from '../layouts/BaseLayout.astro';
import { studio, assetPath } from '../data/queries';

const base = import.meta.env.BASE_URL;
const st = studio();
---

<BaseLayout title="Studio fotograficzne — domowe studio w Krakowie (Czyżyny) | Anna Matejska-Gazda" description="Większość sesji wykonuję w plenerze, ale jest też możliwość sesji w studio: wynajętym w Krakowie lub w moim domowym studiu w dzielnicy Czyżyny.">
  <section class="page-hero">
    <div class="container">
      <span class="kicker">{st.kicker}</span>
      <h1 class="page-title">{st.title}</h1>
      <p class="lead" style="max-width:760px;margin:18px auto 0">{st.intro}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container grid-2">
      {st.sections.map(sec => (
        <div class="prose reveal reveal-up">
          <h2 class="group-title" style="margin-bottom:18px">{sec.title}</h2>
          <ul class="link-list" style="grid-template-columns:1fr">
            {sec.items.map(i => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section style="background:var(--white)">
    <div class="container">
      <span class="kicker">{st.home_title}</span>
      <h2 class="sub-title">{st.home_heading}</h2>
      <ul class="included-list">
        {st.home_items.map(i => <li>{i}</li>)}
      </ul>
      <div class="grid-2" style="margin-top:52px;align-items:start">
        {st.blocks.map(b => (
          <div class="prose reveal reveal-up">
            <h3 class="sub-title" style="margin-bottom:12px">{b.title}</h3>
            {b.paragraphs.map(p => <p>{p}</p>)}
          </div>
        ))}
      </div>
      {st.photos.length > 0 && (
        <div class="grid-4">
          {st.photos.map((p, i) => (
            <figure class={`reveal reveal-up reveal-d${(i % 3) + 1}`}>
              <img src={assetPath(p, base)} alt={`Sesja w domowym studiu — zdjęcie ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
      <p style="margin-top:40px"><a href={`${base}kontakt`} class="btn btn-taupe">{st.cta_button}</a></p>
    </div>
  </section>
</BaseLayout>
