---
import BaseLayout from '../layouts/BaseLayout.astro';
import { oferta } from '../data/queries';

const base = import.meta.env.BASE_URL;
const o = oferta();
// „**pogrubienie**” w danych → <strong> (te same fragmenty, co pogrubione na starej stronie)
const bold = (text) => String(text).split('**');
const CARD_ANIM = ['reveal reveal-left reveal-d1', 'reveal reveal-up reveal-d2', 'reveal reveal-right reveal-d3'];
---

<BaseLayout title="Oferta i cennik — pakiety sesji fotograficznych Kraków | Anna Matejska-Gazda" description="Pakiety sesji fotograficznych w Krakowie: MINI 500 zł, STANDARD 700 zł, PREMIUM 1100 zł. Sesje rodzinne, kobiece, ciążowe, dziecięce, romantyczne i wizerunkowe. Reportaże wyceniane indywidualnie.">
  <section class="page-hero page-hero--group">
    <div class="container">
      <span class="kicker">{o.kicker}</span>
      <!-- pierwsza sekcja tak samo jak kolejne: ta sama czcionka i kolor co nagłówek „Sesje wizerunkowe” -->
      <div class="price-group__head" style="margin-bottom:0">
        <h1 class="sub-title">{o.groups[0].name}</h1>
        <p>{o.groups[0].subtitle}</p>
      </div>
    </div>
  </section>

  {o.groups.map((g, gi) => (
    <section style="padding-top:0">
      <div class="container">
        <div class="price-group" style="margin-top:0">
          {gi > 0 && (
            <div class="price-group__head">
              <h2 class="sub-title">{g.name}</h2>
              <p>{g.subtitle}</p>
            </div>
          )}
          <div class="price-grid">
            {g.packages.map((p, i) => (
              <article class={`price-card ${CARD_ANIM[i % 3]}${i === 1 ? ' price-card--featured' : ''}`}>
                <span class="price-name">{p.name}</span>
                <span class="price-amount">{p.price}</span>
                <ul class="price-features">
                  {p.features.map(f => (
                    <li>{bold(f).map((part, k) => k % 2 ? <strong style="font-weight:600;color:var(--ink)">{part}</strong> : part)}</li>
                  ))}
                </ul>
                <a href={`${base}kontakt`} class={i === 1 ? 'btn btn-taupe' : 'btn btn-line'}>Zapytaj o termin</a>
              </article>
            ))}
          </div>
          {g.note && <p class="price-note">{g.note}</p>}
        </div>
      </div>
    </section>
  ))}

  <section style="background:var(--white)">
    <div class="container">
      <span class="kicker">W cenie</span>
      <h2 class="sub-title">{o.included_title}</h2>
      <ul class="included-list">
        {o.included.map(i => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <!-- oferta indywidualna — kremowe pasmo, wyśrodkowane jak „Masz pytania?” -->
  <section class="offer-invite">
    <div class="container" style="max-width:820px">
      <h2 class="sub-title reveal reveal-up">{o.custom.title}</h2>
      <ul class="q-list">
        {o.custom.questions.map(q => <li class="reveal reveal-up">{q}</li>)}
      </ul>
      <p class="reveal reveal-up" style="color:var(--ink-soft);margin-bottom:28px">{o.custom.text}</p>
      <p class="reveal reveal-up"><a href={`${base}kontakt`} class="btn btn-taupe">Napisz do mnie</a></p>
    </div>
  </section>

  <!-- reportaże — tekst po lewej, zdjęcie w kwadracie po prawej -->
  <section class="offer-reportaze">
    <div class="container split-reportaze">
      <div class="reveal reveal-left">
        <span class="kicker">Reportaże</span>
        <h2 class="sub-title">{o.reportaze.title}</h2>
        <p style="font-weight:600;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);margin:14px 0 18px">{o.reportaze.subtitle}</p>
        {o.reportaze.paragraphs.map(p => <p style="color:var(--ink-soft);margin-bottom:.8rem">{p}</p>)}
        <ul class="price-features" style="margin:22px 0 26px">
          {o.reportaze.packages.map(p => (
            <li><strong style="font-weight:400">{p.name}</strong> — <span style="color:var(--taupe)">{p.price}</span></li>
          ))}
        </ul>
        <a href={`${base}reportaze`} class="btn btn-line">Zobacz reportaże →</a>
      </div>
      <figure class="reveal reveal-right">
        <img src={`${base}images/reportaze-oferta.jpg`} alt="Reportaż fotograficzny — Anna Matejska-Gazda" loading="lazy" />
      </figure>
    </div>
  </section>

  <section style="background:var(--white);text-align:center;padding:72px 0">
    <div class="container prose prose-narrow">
      <span class="kicker">Dalsza część oferty</span>
      <p style="margin-bottom:26px">{o.products_note}</p>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={`${base}albumy`} class="btn btn-line">Albumy</a>
        <a href={`${base}vouchery`} class="btn btn-line">Vouchery</a>
        <a href={`${base}studio`} class="btn btn-line">Studio</a>
        <a href={`${base}oferta-ngo`} class="btn btn-line">Oferta NGO</a>
      </p>
    </div>
  </section>
</BaseLayout>
