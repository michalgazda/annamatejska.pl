---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleries, assetPath } from '../../data/queries';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const all = galleries();
  return all.map(g => ({
    params: { slug: g.slug },
    props: { gallery: g },
  }));
}

const { gallery } = Astro.props;
// Prefer explicit Media-library paths for newly managed galleries.
const explicit = Array.isArray(gallery.photos_list) ? gallery.photos_list.filter(Boolean) : [];
const fallbackCount = gallery.photos || 4;
const photos = explicit.length
  ? explicit.map(p => assetPath(p, base))
  : Array.from({ length: fallbackCount }, (_, i) => `${base}images/galleries/${gallery.slug}/${String(i+1).padStart(2,'0')}-thumb.jpg`);
// miniatura w siatce, pełny rozmiar w powiększeniu
const fullOf = (src) => src.replace(/-thumb(\.[^.]+)$/, '$1');
---

<BaseLayout title={`${gallery.title} — Galeria | Anna Matejska-Gazda Fotograf Kraków`} description={gallery.excerpt} image={(photos[0] || assetPath(gallery.cover, base)).replace(/-thumb(\.[^.]+)$/, '$1')}>
  <section class="page-hero" style="padding-bottom:0">
    <div class="container gal-meta">
      <h1 class="kicker">{gallery.title}</h1>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container">
      <div class="photo-grid">
        {photos.map((src, i) => (
          <figure><img src={fullOf(src)} data-full={fullOf(src)} alt={`${gallery.title} — zdjęcie ${i+1}`} loading="lazy" /></figure>
        ))}
      </div>
      <p style="text-align:center;margin-top:56px"><a class="btn btn-line" href={`${base}galerie`}>← Wszystkie galerie</a></p>
    </div>
  </section>

  {gallery.testimonial && gallery.testimonial.text && (
    <section class="quote opinion">
      <div class="container">
        <figure class="opinion-item">
          <blockquote>„{gallery.testimonial.text}”</blockquote>
          <p class="opinion-author">{gallery.testimonial.author}</p>
        </figure>
      </div>
    </section>
  )}
</BaseLayout>