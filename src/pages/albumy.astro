---
import BaseLayout from '../layouts/BaseLayout.astro';
import { albumy, assetPath, pageHeading } from '../data/queries';

const base = import.meta.env.BASE_URL;
const a = albumy();
---

<BaseLayout title="Albumy i opakowania zdjęć — Anna Matejska-Gazda Fotografia Kraków" description="Projektuję albumy fotograficzne: klasyczne, drukowane na papierze jedwabnym, albumiki eko i harmonijki, a także pudełka i teczki na odbitki. Kraków.">
  <section class="page-hero">
    <div class="container">
      <h1 class="kicker">{pageHeading(a.kicker, a.title)}</h1>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="container">
      <h2 class="group-title reveal reveal-up" style="margin-bottom:20px">{a.scope_title}</h2>
      <ul class="link-list albums-scope reveal reveal-up">
        {a.scope.map(x => <li>{x}</li>)}
      </ul>
    </div>

    {a.photos.length > 0 && (
      <div class="container">
        <div class="grid-4">
          {a.photos.map((p, i) => (
            <figure class={`reveal reveal-up reveal-d${(i % 3) + 1}`}>
              <img src={assetPath(p, base)} alt={`Album fotograficzny — zdjęcie ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    )}

    <div class="container" style="margin-top:72px">
      <h2 class="group-title reveal reveal-up" style="margin-bottom:20px">{a.products_title}</h2>
      <ul class="link-list albums-scope reveal reveal-up">
        {a.products.map(x => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <section class="quote">
    <div class="container">
      <h2 class="script" style="font-size:clamp(1.7rem,3.2vw,2.4rem);color:var(--taupe);margin-bottom:16px">{a.cta_title}</h2>
      <blockquote style="font-size:1.15rem">{a.cta_text}</blockquote>
      <cite style="margin-top:22px"><a href={`${base}kontakt`} class="btn btn-line">{a.cta_button}</a></cite>
    </div>
  </section>
</BaseLayout>
