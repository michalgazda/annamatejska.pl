---
// Ozdobny motyw dla kafelka bez zdjęcia (kalendarz plenerów) — cienka kreska, kolor z CSS.
// name: 'sad' | 'mak' | 'winnica' | 'sianokosy' | cokolwiek innego → gałązka
interface Props {
  name?: string;
}
const { name = '' } = Astro.props;
---

<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'sad' && (
    <>
      <path d="M32 54V36" />
      <path d="M32 42c-4-1-7-4-8-8" />
      <path d="M32 46c4-1 7-4 8-8" />
      <circle cx="32" cy="25" r="11" />
      <circle cx="21" cy="31" r="6" />
      <circle cx="43" cy="31" r="6" />
      <circle cx="33" cy="19" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="26" cy="24" r="1.2" fill="currentColor" stroke="none" />
      <circle cx="40" cy="28" r="1.2" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'mak' && (
    <>
      <path d="M32 30v24" />
      <path d="M32 38c-3-2-6-2-8-1" />
      <path d="M32 20c-6-6-13-4-13 2 0 5 6 8 13 8s13-3 13-8c0-6-7-8-13-2Z" />
      <circle cx="32" cy="26" r="3.4" />
      <path d="M46 46c-4 1-7 0-9-2" />
    </>
  )}
  {name === 'winnica' && (
    <>
      <path d="M32 22V13" />
      <path d="M32 16c3-3 7-3 10 0" />
      <circle cx="32" cy="26" r="4.3" />
      <circle cx="26" cy="33" r="4.3" />
      <circle cx="38" cy="33" r="4.3" />
      <circle cx="32" cy="40" r="4.3" />
      <path d="M12 50c6-4 10-4 14 0" />
    </>
  )}
  {name === 'sianokosy' && (
    <>
      <path d="M20 52c0-14 2-22 6-26" />
      <path d="M32 54V18" />
      <path d="M44 52c0-14-2-22-6-26" />
      <path d="M32 25l5-4M32 25l-5-4M32 32l5-4M32 32l-5-4M32 39l5-4M32 39l-5-4" />
      <path d="M20 50c0-8 1-12 3-15" />
    </>
  )}
  {!['sad', 'mak', 'winnica', 'sianokosy'].includes(name) && (
    <>
      <path d="M32 55V20" />
      <path d="M32 29c-5.6 0-9.8-3.3-9.8-8.6 5.6 0 9.8 3.3 9.8 8.6Z" />
      <path d="M32 29c5.6 0 9.8-3.3 9.8-8.6-5.6 0-9.8 3.3-9.8 8.6Z" />
      <path d="M32 41c-5.6 0-9.8-3.3-9.8-8.6 5.6 0 9.8 3.3 9.8 8.6Z" />
      <path d="M32 41c5.6 0 9.8-3.3 9.8-8.6-5.6 0-9.8 3.3-9.8 8.6Z" />
    </>
  )}
</svg>
